# =============================================================
# Caddy 反向代理配置 — 国内一键 HTTPS
#
# 行为：
#   - 若 .env 设置了 MANHUAJU_DOMAIN=xxx.com，则自动申请 Let's Encrypt 证书（前提：80/443 端口公网可达）
#   - 否则直接监听 :80，HTTP 访问（无 TLS）
# =============================================================

# 让 Caddy 检测 MANHUAJU_DOMAIN 环境变量
{
    email admin@manhuaju.local
    # 如果国内 LE 申请慢，可以解开下行改用 ZeroSSL（更稳）
    # acme_ca https://acme.zerossl.com/v2/DV90
    # acme_eab eab_id eab_hmac_key
}

# 主入口：MANHUAJU_DOMAIN 有值时走 TLS；无值时走 :80
{$MANHUAJU_DOMAIN::80} {
    encode zstd gzip

    # 客户端最大上传 100 MB（小说原文/封面图）
    request_body {
        max_size 100MB
    }

    # / 静态控制台 + API 都打到 manhuaju-api:8080
    reverse_proxy manhuaju-api:8080 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            keepalive 30s
            keepalive_idle_conns 32
            response_header_timeout 10m   # 同步等长任务
        }
    }

    # 简易访问日志
    log {
        output file /data/access.log {
            roll_size 50mb
            roll_keep 5
        }
        format console
    }
}
