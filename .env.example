# ============================================================
# AI 漫剧 Autopilot v4 — 环境变量模板
# 复制为 .env 后填入；切勿提交到 Git。
# ============================================================

# 全局运行模式： mock | live | hybrid
MANHUAJU_LIVE_MODE=live
MANHUAJU_API_DATA=./api_data

# ------------------------------------------------------------
# Shell 1 — 编剧大脑 (Claude Opus 4 ★ 首选)
# ------------------------------------------------------------
# https://console.anthropic.com/  (256K context, multimodal)
ANTHROPIC_API_KEY=
# 备用：通过 AWS Bedrock 走 Claude（可选）
# AWS_BEDROCK_REGION=us-east-1

# ------------------------------------------------------------
# Shell 2 & 3 — 火山引擎 Visual Service ★ 核心
#   - Seedream 5.0 / Jimeng 4.6 (主角参考图 + 场景大图)
#   - 小云雀 Agent 2.0 「有参考」(skylark_video_agent_v2_with_ref)
#   - 小云雀 短剧漫剧 Agent (Seedance 2.0 fast 720p)
# https://console.volcengine.com/iam/keymanage/
# ------------------------------------------------------------
VOLCENGINE_VISUAL_AK=
VOLCENGINE_VISUAL_SK=
VOLCENGINE_VISUAL_REGION=cn-north-1
# 小云雀模型版本（可选；缺省取最新）
VOLCENGINE_XIAOYUNQUE_REQ_KEY=skylark_video_agent_v2_with_ref
VOLCENGINE_DUANJU_REQ_KEY=skylark_duanju_manhuaju_seedance_2_fast_720p

# 火山方舟 Ark (Doubao Seed 1.6 VLM 多模态质检 + Seedance 兜底)
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_API_KEY=
ARK_API_KEY=

# ------------------------------------------------------------
# 对象存储 TOS — 必填，小云雀「有参考」接口要求图片 URL 可访问
# ------------------------------------------------------------
VOLCENGINE_TOS_AK=
VOLCENGINE_TOS_SK=
VOLCENGINE_TOS_REGION=cn-beijing
VOLCENGINE_TOS_ENDPOINT=tos-cn-beijing.volces.com
VOLCENGINE_TOS_BUCKET=manhuaju-assets
# 可选：CDN 加速域名（绑定到 TOS 桶后填）
VOLCENGINE_TOS_CDN_DOMAIN=

# ------------------------------------------------------------
# Shell 4 — 单镜重生兜底
# ------------------------------------------------------------
# fal.ai (Wan 2.7 FLF 首末帧锁脸)
FAL_KEY=

# ------------------------------------------------------------
# Shell 5 — 后期 BGM/SFX (版权干净)
# ------------------------------------------------------------
# https://elevenlabs.io/docs/api-reference (music + sound generation)
ELEVENLABS_API_KEY=

# ------------------------------------------------------------
# 阿里 DashScope (WanX / CosyVoice / text-embedding-v3) — 兜底链
# ------------------------------------------------------------
DASHSCOPE_API_KEY=

# ------------------------------------------------------------
# LLM 兜底链 — 任一即可
# ------------------------------------------------------------
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ------------------------------------------------------------
# Workflow
# workflow.mode = autopilot | supervised  (亦可在 config/system.yaml)
# ------------------------------------------------------------
MANHUAJU_VIDEO_PRIMARY=volcengine_xiaoyunque
MANHUAJU_IMAGE_PRIMARY=volcengine_seedream
MANHUAJU_LLM_PRIMARY=anthropic
MANHUAJU_MUSIC_PRIMARY=elevenlabs

# ------------------------------------------------------------
# 可选：可观测性
# ------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.volces.com
# OTEL_SERVICE_NAME=manhuaju-api
# PROMETHEUS_PUSH_GATEWAY=
