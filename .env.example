# ============================================================
# AI 漫剧 Autopilot v4 — 环境变量模板（国内优先版）
# 复制为 .env 后填入；切勿提交到 Git。
# ============================================================

# 全局运行模式： mock | live | hybrid
MANHUAJU_LIVE_MODE=live
MANHUAJU_API_DATA=./api_data

# ============================================================
# ★★★ 国内必备 — 拿到这 3 把 Key 就能直接上线（无需境外信用卡/VPN）★★★
# ============================================================

# ------------------------------------------------------------
# [国内必备 1] 火山引擎 Visual Service — 视频 + 图像
#   - 小云雀 Agent 2.0（视频）+ Seedream 5.0/即梦 4.6（图像）
# 控制台：https://console.volcengine.com/iam/keymanage
# ------------------------------------------------------------
VOLCENGINE_VISUAL_AK=
VOLCENGINE_VISUAL_SK=
VOLCENGINE_VISUAL_REGION=cn-north-1
# 应用 ReqKey（火山控制台-视觉智能-应用列表 复制即可；常见默认值已填）
VOLCENGINE_XIAOYUNQUE_REQ_KEY=skylark_video_agent_v2_with_ref
VOLCENGINE_DUANJU_REQ_KEY=skylark_duanju_manhuaju_seedance_2_fast_720p

# ------------------------------------------------------------
# [国内必备 2] 火山引擎 Ark — 编剧大脑 + 多模态质检 + 兜底
#   Doubao Seed 1.6 / 1.6 VLM / Seedance
# 控制台：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# ------------------------------------------------------------
VOLCENGINE_ARK_API_KEY=
# 兼容：以下三个变量任一存在均生效
VOLCENGINE_API_KEY=
ARK_API_KEY=

# ------------------------------------------------------------
# [国内必备 3] 火山引擎 TOS — 对象存储
#   小云雀「有参考」接口要求图片 URL 可公网拉取；TOS 桶需开「公共读」+ CORS GET *
# 控制台：https://console.volcengine.com/tos
# ------------------------------------------------------------
VOLCENGINE_TOS_AK=
VOLCENGINE_TOS_SK=
VOLCENGINE_TOS_REGION=cn-beijing
VOLCENGINE_TOS_ENDPOINT=tos-cn-beijing.volces.com
VOLCENGINE_TOS_BUCKET=manhuaju-assets
# 可选：CDN 加速域名（备案后绑定 TOS 桶）
VOLCENGINE_TOS_CDN_DOMAIN=

# ============================================================
# 国内可选（任一即可，丰富 LLM 兜底链；不填也不影响主线）
# ============================================================

# 阿里 DashScope (通义千问 / WanX / CosyVoice / text-embedding-v3)
# 控制台：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# ============================================================
# 部署到阿里云 FC 3.0（无服务器，推荐用量波动大场景）
# 仅 deploy/aliyun-fc/aliyun-fc-go-live.ps1 用到；不填不影响应用本身运行
# ============================================================
# 主账号 AccessKey（用于 ACR + FC OpenAPI 自动建资源）
# 控制台：https://ram.console.aliyun.com/manage/ak
# ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI5tXXXXXXXXXXXX
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXX

# DeepSeek 国产开源大模型（V3.2 / R1）
# 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 智谱 GLM-4.5
# 控制台：https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=

# 月之暗面 Kimi K2
# 控制台：https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# ============================================================
# 国际版（高级可选 — 想要更顶级效果时再开通；需境外信用卡）
# ============================================================

# Anthropic Claude Opus 4.7 — 编剧大脑顶配（不填则用 Doubao Seed 1.6）
# 控制台：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs — Music+SFX 顶配（不填则用本地预制曲库 + ffmpeg 合成）
# 控制台：https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# fal.ai Wan 2.7 FLF — 脸锁修复顶配（不填则用火山 Seedance 单镜重生）
# 控制台：https://fal.ai/dashboard/keys
FAL_KEY=

# 其它备用 LLM
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ============================================================
# Workflow 偏好（国内默认；想切回国际版改这些即可）
# ============================================================
MANHUAJU_VIDEO_PRIMARY=volcengine_xiaoyunque
MANHUAJU_IMAGE_PRIMARY=volcengine_seedream
MANHUAJU_LLM_PRIMARY=ark_doubao_seed_1_6
MANHUAJU_MUSIC_PRIMARY=local_library

# ============================================================
# 可观测性（可选）
# ============================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.volces.com
# OTEL_SERVICE_NAME=manhuaju-api
# PROMETHEUS_PUSH_GATEWAY=
